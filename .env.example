# ---------------------------------------------------------------------------
# bad-posture-detection configuration
# Copy this file to `.env` and edit the values.
# ---------------------------------------------------------------------------

# How the 6-hourly summary is delivered: ntfy | desktop | email
NOTIFICATION_METHOD=ntfy

# ntfy.sh topic. NO signup or API key is needed, which also means anyone who
# knows the exact topic name can read your notifications -- so make this long
# and unguessable (e.g. posture-7f3a9c21b8e4d6). Subscribe on your phone with
# the ntfy app, or in a browser at https://ntfy.sh/<your-topic>
NTFY_TOPIC=your-unguessable-topic-name-here

# Reporting window / scheduler period, in hours.
CHECK_INTERVAL_HOURS=6

# Only notify if bad posture in the window reached at least this many minutes.
BAD_POSTURE_ALERT_THRESHOLD_MINUTES=30

# Craniovertebral angle thresholds, in degrees (larger = more upright head).
CVA_GOOD_THRESHOLD=53
CVA_BAD_THRESHOLD=48

# Torso lean off vertical, in degrees (smaller = more upright torso).
TORSO_GOOD_THRESHOLD=15
TORSO_BAD_THRESHOLD=25

# Webcam device index passed to OpenCV.
CAMERA_INDEX=0

# Optional: use a different MediaPipe pose bundle (downloads lite model by default).
# POSE_MODEL_PATH=models/pose_landmarker_full.task

# How often a posture sample is written to the database, in seconds.
SAMPLE_INTERVAL_SECONDS=1

# ---------------------------------------------------------------------------
# Optional: only used when NOTIFICATION_METHOD=email
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SENDER_EMAIL=you@example.com
# RECIPIENT_EMAIL=you@example.com
